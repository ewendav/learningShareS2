<div class="session-card lesson-card">

  <div class="horizontal-display header-session-card">
    
    <div class="flex" style="gap:.5rem;" >
          <img
      {% if not user.avatarPath %}
        style="opacity:0;"
      {% endif %}
          src="{{ user.avatarPath }}" class="avatar" >
      <p>{{userName}}</p>

    </div>

    <h3>{{ traduction('lesson') }}</h3>

    <div class="flex" style="gap:.5rem; opacity : 0;" >
      <img src="{{ avatarPath }}" class="avatar" >
      <p>{{userName}}</p>

    </div>

  </div>


  <div class="horizontal-display">
    
    <div class="vertical-display horizontal-sidebar">

      <p>{{traduction('categorie')}} : {{ categoryLearned }}</p>

      <p>{{traduction('competence')}} : {{ skillLearned }}</p>

    </div>


    <div>
    </div>


    <div class="vertical-display location-part">
      
      <p>{{traduction('lieu')}} : {{ adresse }}</p>

      <p>{{traduction('date')}} : {{ date }}</p>

    </div>

  </div>


        {% if user %}
        <form action="/rejoindreCours/{{ session_id }}" method="POST">
            <button class="form-button green-bg" type="submit">{{traduction('rejoindreCours')}}</button>
        </form>
        {% else %}
        <a href="/login">
            <button class="form-button green-bg" type="button">{{traduction('rejoindreCours')}}</button>
        </a>
        {% endif %}

</div>
